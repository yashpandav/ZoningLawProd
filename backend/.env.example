# Backend environment variables — copy to backend/.env for local dev
# For production, secrets are loaded from Oracle Vault via load-secrets.sh

# ── AI APIs ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
VOYAGE_API_KEY=pa-...

# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333           # local dev
# QDRANT_URL=https://YOUR_CLUSTER.qdrant.io  # Qdrant Cloud (prod)
QDRANT_API_KEY=                            # blank for local, set for Qdrant Cloud

# ── Relational DB (PostGIS) ───────────────────────────────────────────────────
DB_URL=postgresql://user:pass@localhost:5433/toronto_zoning
# Production: postgresql://zoning_user:PASSWORD@postgis:5432/toronto_zoning

# ── Model selection ───────────────────────────────────────────────────────────
CHAT_MODEL=gpt-4.1
QUICK_ANSWER_MODEL=gpt-4.1-mini

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_PACKGEN=false    # set true to mount /api/generate-pack/* routes
ENABLE_SOLVER=false     # set true to use the deterministic layout solver

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
# Production: ALLOWED_ORIGINS=https://app.yashpandav.dev,https://api.yashpandav.dev

# ── LangSmith observability (optional) ────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=zoning-demo
LANGSMITH_API_KEY=ls__...
